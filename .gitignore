# Secretos (nunca subir)
.wokwi_token
*.token
.env
.env.*
*.key

# Artefactos de compilacion PlatformIO
.pio/

# Salidas de simulacion (regenerables)
arduino/run.png
serial.log
.diagram.*.json

# Dependencias / entornos (workspaces de slides y tools)
**/node_modules/
**/.venv/
**/__pycache__/
**/*.pyc

# Artefactos de build (.NET, bundlers)
**/bin/
**/obj/
**/dist/
*.bak

# Ruido de SO/editor
.DS_Store
Thumbs.db
~$*

# Capturas temporales de verificacion
.playwright-cli/
/output/

# Previews de render de PPT (regenerables, no versionar)
**/ppt/rendered/
**/ppt/montage.png
**/ppt/montage-*.png
**/ppt/revision-*.png
**/ppt/validation-*/
**/ppt/*.optimized.pptx

# Salidas intermedias de diseño de PCB (el archivo vigente es geogreen-v1.kicad_pcb)
/geogreen-v1/hardware/kicad/geogreen-v0.kicad_pcb

# Entregables comprimidos para enviar (no versionar; GitHub se queja con binarios grandes)
/entregables/
*.rar
